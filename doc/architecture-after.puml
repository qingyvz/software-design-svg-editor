@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction
title Phase 2 - explicit host composition and abstract extension contracts
component "Main + DefaultShapes\ncomposition root" as Host
component "PluginLoader / PluginInstaller\nresolve, stage, validate, rollback" as Loader
component "application public contracts\nCommand / CommandReceiver / DocumentQuery\nTreeDecorator / AttributeHandler / PluginContext" as Ports
component "domain contracts\nShapeProvider / Shape / ShapeContainer" as ShapePorts
component "application\nEditor / history / draft transaction\nTreeFormatter" as App
component "domain\nShapeFactory / SvgDocument\ngeometry and invariants" as Domain
component "CLI\nCommandFactory / Dispatcher / ConsoleApp" as CLI
component "infrastructure\nSvgCodec / NodeDocumentStore" as Infra
component "stats / dir / box / star\nindependent manifests and classes" as Plugins
component "DirectoryAccess\nplugin-owned target" as DirPort
component "NodeDirectoryAccess\nadapter" as DirAdapter
component "node:fs / Dirent / process\nadaptee" as NodeFS
component "VSCode extension\nFileDecorationProvider\nDocumentSymbolProvider" as VS
component "VSCode host\nExplorer / Outline / TextDocument" as VSHost
component "SVG symbol parser\nXML + UTF-16 source ranges" as Parser
Host --> CLI
Host --> App
Host --> Domain
Host --> Infra
Host --> Plugins : code assembly
Host --> Loader : config assembly
Loader --> Ports
Loader --> ShapePorts
CLI --> Ports
App --> Ports
App --> Domain
Domain --> ShapePorts : calls registered providers
Infra --> Domain
Infra --> Ports : DocumentPort
Plugins ..> Ports : implements
Plugins ..> ShapePorts : implements / consumes public domain behavior
Plugins --> DirPort : DirCommand client
DirAdapter ..> DirPort : implements
DirAdapter --> NodeFS
VSHost --> VS : activate / call registered providers
VS --> Parser
note bottom of Host
Six built-in provider choices live in DefaultShapes.
The registry does not import concrete providers.
A/B proof commits have the same box-free parent.
end note
note bottom of VS
Independent package, not a CLI dependency.
Screenshots capture actual Explorer/Outline;
unsaved edits are restored without disk writes.
end note
@enduml
