@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowColor #536273
skinparam componentBackgroundColor #F6F8FA
skinparam packageBackgroundColor #FFFFFF
top to bottom direction
title SVG editor - module dependencies
component "Main\nassembly / plugin registration" as Main
package cli {
  component "ConsoleApp / CommandDispatcher\nCommandFactory / Tokenizer / Arguments" as CLI
}
package application {
  component "Editor / EditContext / EditScope\nCommand / EditingCommand / commands\nHistory / EditRecord / TreeFormatter / ShapeFormatter\nDocumentPort" as App
}
package infrastructure {
  component "NodeDocumentStore\nSvgCodec / SvgTransform / CanvasTextMeasurer" as Infra
}
package domain {
  component "SvgDocument / ShapeContainer\nShape / Group / geometry classes\nAffineTransform / Bounds / TextMeasurer\nShapeFactory / ShapeProvider" as Domain
}
package plugins {
  component "Box / BoxProvider" as Plugin
}
Main --> CLI
Main --> Infra
Main --> Domain : shared factory
Main --> Plugin : optional
CLI --> App
CLI --> Domain : Numbers
Infra --> App : DocumentPort
Infra --> Domain
App --> Domain
Plugin --> Domain
@enduml
